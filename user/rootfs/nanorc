## System-wide nano configuration for NEWOS.
## Installed as /usr/etc/nanorc; nano loads it before ~/.nanorc.

set autoindent
set linenumbers
set constantshow

## ---------------------------------------------------------------------------
## C and C++
## ---------------------------------------------------------------------------
syntax "c" "\.([ch](pp|xx)?|C|cc|c\+\+|H|hh)$"
comment "//"
color brightred "\<[A-Z_][0-9A-Z_]*\>"
color green "\<(auto|bool|char|const|double|enum|extern|float|inline|int|long|register|restrict|short|signed|sizeof|static|struct|typedef|union|unsigned|void|volatile)\>"
color green "\<([[:lower:]][[:lower:]_]*|(u_?)?int(8|16|32|64))_t\>"
color brightyellow "\<(if|else|for|while|do|switch|case|default)\>"
color brightyellow "\<(break|continue|goto|return)\>"
color brightmagenta "'([^']|\\(["'\abfnrtv]|x[[:xdigit:]]{1,2}|[0-3]?[0-7]{1,2}))'"
color cyan "__attribute__[[:blank:]]*\(\([^)]*\)\)|__(aligned|asm|builtin|hidden|inline|packed|restrict|section|typeof|weak)__"
color brightyellow "\"([^\"]|\\.)*\"|#[[:blank:]]*include[[:blank:]]*<[^>]+>"
color brightcyan "^[[:blank:]]*#[[:blank:]]*(if(n?def)?|elif|warning|error|pragma)\>"
color brightcyan "^[[:blank:]]*#[[:blank:]]*((define|else|endif|include(_next)?|line|undef)\>|$)"
color brightblue "//.*"
color brightblue start="/\*" end="\*/"
color brightwhite,yellow "\<(FIXME|TODO|XXX)\>"
color ,green "[[:space:]]+$"

## ---------------------------------------------------------------------------
## Shell scripts (including /etc/nsh.rc)
## ---------------------------------------------------------------------------
syntax "sh" "\.sh$|(^|/|\.)(a|ba|c|da|k|mk|pdk|tc|z)?sh(rc|_profile)?$|(^|/)\.profile$|(^|/)nsh\.rc$"
comment "#"
color brightgreen "^[A-Za-z0-9_-]+\(\)"
color green "\<(break|case|continue|do|done|elif|else|esac|exit|fi|for|function|if|in|read|return|select|shift|then|time|until|while)\>"
color green "\<(declare|eval|exec|export|let|local)\>"
color brightmagenta "[[:blank:]](-[A-Za-z]|--\<[A-Za-z-]+)\>"
color brightblue "\<(awk|cat|cd|ch(grp|mod|own)|cp|cut|echo|env|grep|head|install|ln|make|mkdir|mv|printf|rm|rmdir|sed|sort|tail|tar|touch|umask|unset)\>"
color brightred "\$([-@*#?$!0-9]|[[:alpha:]_][[:alnum:]_]*)"
color cyan "(^|[[:blank:]])#.*"
color brightyellow "\"([^\"]|\\.)*\"|'([^']|\\.)*'"
color ,green "[[:space:]]+$"

## ---------------------------------------------------------------------------
## Makefiles
## ---------------------------------------------------------------------------
syntax "makefile" "(^|/)((GNU)?m|M)akefile[^/]*$|\.(make|mk)$"
comment "#"
color red " (:?:|\+|\?)?= "
color magenta "^(if|ifn?def|ifn?eq|else|endif|(-|s)?include)\>"
color magenta "^((override +)?(un)?define|endef|(un)?export|private|vpath)\>"
color blue "\$+[{(][a-zA-Z0-9_-]+[})]"
color brightblue "^[^	].*:"
color green "(^|[[:blank:]]+)#.*"
color ,green "[[:space:]]+$"

## ---------------------------------------------------------------------------
## nanorc files
## ---------------------------------------------------------------------------
syntax "nanorc" "(^|/)\.?nanorc$"
comment "#"
color brightcyan "^[[:blank:]]*(set|unset|syntax|header|magic|comment|linter|formatter|include|color|start|end|tabgives)\>"
color brightyellow "\"([^\"]|\\.)*\""
color cyan "(^|[[:blank:]])#.*"
color ,green "[[:space:]]+$"
