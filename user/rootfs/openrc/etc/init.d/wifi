#!/bin/sh
# /etc/init.d/wifi: bring up the wireless interface at boot.
# Connects to the SSID from /etc/conf.d/wifi on the virtual radio (wlan0).
# NOTE: the NEWOS service-script interpreter is Bourne-ish but has no
# if/then/fi or test builtin, so this script stays to plain commands.

depend() {
    need localmount
    after bootmisc
}

start() {
    echo "wifi: auto-connecting at boot"
    wifi connect $wifi_ssid $wifi_pass $wifi_timeout
    wifi status
}

stop() {
    echo "wifi: stopping"
    wifi disconnect
}

status() {
    wifi status
}
