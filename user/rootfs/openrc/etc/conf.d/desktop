# /etc/conf.d/desktop - graphical session parameters (KEY=VALUE).
# Read by /etc/init.d/desktop through the $session_program substitution.
# Quake 2 (GPL-2.0) is the default graphical session: it owns the framebuffer
# and shows a startup splash. Run `/bin/voxel` from nsh for the classic desktop.
session_program="/bin/quake2"
