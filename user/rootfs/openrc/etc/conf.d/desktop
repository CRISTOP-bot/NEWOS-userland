# /etc/conf.d/desktop - graphical session parameters (KEY=VALUE).
# Read by /etc/init.d/desktop through the $session_program substitution.
# /bin/desktop is the NEWOS-native Win95 session: it sizes its canvas to the
# framebuffer the bootloader picked, so it runs at the monitor's native
# resolution. The classic VOXEL desktop stays installed at /bin/voxel.
session_program="/bin/desktop"
